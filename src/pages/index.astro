---
import avatar from '../assets/avatar.png';
import '../styles/scss/main.scss';

const githubUrl = 'https://github.com/LostCausePublication';
const twitterUrl = 'https://x.com/lostcause_dev';
const year = new Date().getFullYear();

const siteDescription =
	'A not-so-serious coding publication about open source, CLI tools, programming languages, and fun projects.';
const themeColor = '#f9f7f2';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteDescription} />
		<meta name="theme-color" content={themeColor} />
		<title>Lost Cause Publication | AI does it faster, but this is more fun</title>

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=Share+Tech+Mono&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main class="page">
			<div class="hero">
				<img class="avatar" src={avatar.src} width={avatar.width} height={avatar.height} alt="" />

				<p class="status">Under construction</p>

				<h1 class="title">
					<span class="title-primary">LOSTCAUSE.</span><span class="title-accent">DEV</span>
				</h1>

				<p class="subtitle">AI does it faster, but this is more fun</p>

				<p class="description">
					A not-so-serious <span class="description-highlight">coding publication</span> about open source, CLI tools, programming languages,
					and fun projects.
				</p>

				<nav class="social" aria-label="Social links">
					<a class="social-link" href={githubUrl} target="_blank" rel="noopener noreferrer">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"
							></path>
						</svg>
					</a>
					<a class="social-link" href={twitterUrl} target="_blank" rel="noopener noreferrer">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							></path>
						</svg>
					</a>
				</nav>
			</div>

			<footer class="footer">
				<p>&copy; {year} Lost Cause Publication</p>
				<p>
					Made with ❤️ by
					<a href="https://razvanmuntian.com" target="_blank" rel="noopener noreferrer"
						>Razvan Muntian</a
					>
				</p>
			</footer>
		</main>

        <!-- 100% privacy-first analytics -->
        <script data-collect-dnt="true" async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
        <noscript><img src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade"/></noscript>
	</body>
</html>
