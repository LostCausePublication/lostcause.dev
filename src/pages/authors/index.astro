---
import PageLayout from '../../components/layout/PageLayout.astro';
import AuthorCard from '../../components/author/AuthorCard.astro';
import { getAllAuthors, getAuthorSlug } from '../../lib/authors';
import { collectionPageJsonLd, getCanonicalUrl } from '../../lib/seo';

const authors = await getAllAuthors();
const title = 'Authors';
const description = 'The people writing for Lost Cause Publication.';
const canonicalPath = '/authors/';
---

<PageLayout
	seo={{
		title,
		description,
		canonicalPath,
		jsonLd: collectionPageJsonLd({
			name: title,
			description,
			url: getCanonicalUrl(canonicalPath),
			items: authors.map((author) => ({
				name: author.data.name,
				url: getCanonicalUrl(`/authors/${getAuthorSlug(author)}/`),
			})),
		}),
	}}
	breadcrumbs={[{ label: 'Authors' }]}
>
	<section class="page-section">
		<h1 class="page-section__title">Authors</h1>
		<p class="page-section__description">Meet the folks behind the posts.</p>

		<ul class="author-list">
			{authors.map((author) => (
				<li>
					<AuthorCard author={author} />
				</li>
			))}
		</ul>
	</section>
</PageLayout>
