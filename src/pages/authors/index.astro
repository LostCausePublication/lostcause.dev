---
import PageLayout from '../../components/layout/PageLayout.astro';
import AuthorCard from '../../components/author/AuthorCard.astro';
import { getAllAuthors } from '../../lib/authors';

const authors = await getAllAuthors();
---

<PageLayout
	seo={{
		title: 'Authors',
		description: 'The people writing for Lost Cause Publication.',
        canonicalPath: '/authors/',
	}}
>
	<section class="page-section">
		<h1 class="page-section__title">Authors</h1>
		<p class="page-section__description">Meet the folks behind the posts.</p>

		<ul class="author-list">
			{authors.map((author) => (
				<li>
					<AuthorCard author={author} />
				</li>
			))}
		</ul>
	</section>
</PageLayout>
