---
import PageLayout from '../../components/layout/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogCategoryList from '../../components/blog/BlogCategoryList.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<PageLayout
	seo={{
		title: 'Blog',
		description:
			'Articles about the JavaScript/TypeScript ecosystem, open-source projects and CLI tools.',
		canonicalPath: '/blog',
	}}
	breadcrumbs={[{ label: 'Blog' }]}
>
	<section class="page-section">
		<h1 class="page-section__title">Blog</h1>
		<p class="page-section__description">
			The JavaScript/TypeScript ecosystem, open-source projects and CLI tools, for the joy of coding.
		</p>

		<BlogCategoryList />

		{
			posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			) : (
				<p>No posts yet. Check back soon.</p>
			)
		}
	</section>
</PageLayout>
