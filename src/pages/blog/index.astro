---
import PageLayout from '../../components/layout/PageLayout.astro';
import PostCard from '../../components/blog/PostCard.astro';
import BlogSidebar from '../../components/sidebar/BlogSidebar.astro';
import { getPostSlug, getPublishedPosts } from '../../lib/blog';
import { collectionPageJsonLd, getCanonicalUrl } from '../../lib/seo';

const posts = await getPublishedPosts();
const title = 'Blog';
const description =
	'Articles about the JavaScript/TypeScript ecosystem, open-source projects and CLI tools.';
---

<PageLayout
	seo={{
		title,
		description,
		canonicalPath: '/blog/',
		jsonLd: collectionPageJsonLd({
			name: title,
			description,
			url: getCanonicalUrl('/blog/'),
			items: posts.map((post) => ({
				name: post.data.title,
				description: post.data.description,
				url: getCanonicalUrl(`/blog/${getPostSlug(post)}/`),
			})),
		}),
	}}
	breadcrumbs={[{ label: 'Blog' }]}
	sidebarLabel="Browse the blog"
>
	<section class="page-section">
		<h1 class="page-section__title">Blog</h1>
		<p class="page-section__description">
			The JavaScript/TypeScript ecosystem, open-source projects and CLI tools, for the joy of coding.
		</p>

		{
			posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			) : (
				<p>No posts yet. Check back soon.</p>
			)
		}
	</section>

	<BlogSidebar slot="sidebar" />
</PageLayout>
