---
import PageLayout from '../../../components/layout/PageLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import BlogSidebar from '../../../components/sidebar/BlogSidebar.astro';
import { getPostSlug } from '../../../lib/blog';
import { getCategoryStats, getPostsByCategory } from '../../../lib/categories';
import { collectionPageJsonLd, getCanonicalUrl } from '../../../lib/seo';
export async function getStaticPaths() {
	const categories = await getCategoryStats();

	return categories.map((category) => ({
		params: { slug: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const posts = await getPostsByCategory(category.slug);
const title = `${category.name} posts`;
const description = `All posts in the ${category.name} category on Lost Cause Publication.`;
const canonicalPath = `/blog/category/${category.slug}/`;
---

<PageLayout
	seo={{
		title,
		description,
		canonicalPath,
		jsonLd: collectionPageJsonLd({
			name: title,
			description,
			url: getCanonicalUrl(canonicalPath),
			items: posts.map((post) => ({
				name: post.data.title,
				description: post.data.description,
				url: getCanonicalUrl(`/blog/${getPostSlug(post)}/`),
			})),
		}),
	}}
	breadcrumbs={[
        { label: 'Blog', href: '/blog/' },
		{ label: category.name },
	]}
	sidebarLabel="Browse the blog"
>
	<BlogSidebar slot="sidebar" activeCategorySlug={category.slug} />
	<section class="page-section">
		<h1 class="page-section__title">{category.name}</h1>
		<p class="page-section__description">
			{category.count} {category.count === 1 ? 'post' : 'posts'} in this category.
		</p>

		{
			posts.length > 0 ? (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<PostCard post={post} />
						</li>
					))}
				</ul>
			) : (
				<p>No posts in this category yet.</p>
			)
		}
	</section>
</PageLayout>
