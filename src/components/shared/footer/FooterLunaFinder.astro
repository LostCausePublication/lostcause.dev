---
import lunaFinderLogo from '../../../assets/lunafinder.svg';
import { LUNAFINDER } from '../../../lib/site';
---

<div class="footer-lunafinder">
	<a class="footer-lunafinder__brand" href={LUNAFINDER.url} target="_blank" rel="noopener">
		<span class="footer-lunafinder__powered">
			<span class="footer-lunafinder__site">
				<span class="footer-lunafinder__site-primary">LOSTCAUSE.</span><span
					class="footer-lunafinder__site-accent">DEV</span
				>
			</span>
			is powered by
			<span class="footer-lunafinder__partner">
				<img
					class="footer-lunafinder__logo"
					src={lunaFinderLogo.src}
					width="24"
					height="24"
					alt="LunaFinder logo"
				/>
				<strong>{LUNAFINDER.name}</strong>
			</span>
		</span>
	</a>
	<p class="footer-lunafinder__description">The AI Photo Manager for macOS.</p>
	<p class="footer-lunafinder__description">Works with your existing folders and hard drives.</p>
	<p class="footer-lunafinder__highlights">🌧️ No cloud. 💰 No subscription.</p>
</div>
