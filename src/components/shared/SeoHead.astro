---
import { Font } from 'astro:assets';
import type { BreadcrumbItem } from '../../lib/breadcrumbs';
import { getDefaultOgImage } from '../../lib/og-images';
import { SITE } from '../../lib/site';
import {
	blogPostingJsonLd,
	breadcrumbListJsonLd,
	getCanonicalUrl,
	getPageTitle,
	webPageJsonLd,
	type SeoData,
} from '../../lib/seo';

interface Props extends SeoData {
	breadcrumbs?: BreadcrumbItem[];
}

const {
	title,
	description = SITE.description,
	canonicalPath,
	image,
	imageAlt,
	imageWidth,
	imageHeight,
	type = 'website',
	publishedTime,
	modifiedTime,
	authors = [],
	categories = [],
	keywords,
	noIndex = false,
	jsonLd: jsonLdOverride,
	markdownPath,
	breadcrumbs,
} = Astro.props;

const pathname = canonicalPath ?? Astro.url.pathname;
const canonicalUrl = getCanonicalUrl(pathname);
const pageTitle = getPageTitle(title);
const fallbackImage = getDefaultOgImage();
const ogImage = image ?? fallbackImage.url;
const ogImageWidth = imageWidth ?? fallbackImage.width;
const ogImageHeight = imageHeight ?? fallbackImage.height;
const ogImageAltText = imageAlt ?? description;
const robots = noIndex ? 'noindex, nofollow' : 'index, follow';
const twitterHandle = SITE.twitterUrl.replace('https://x.com/', '@');
const metaKeywords = [...(keywords ?? SITE.keywords), ...categories];
const keywordsContent = [...new Set(metaKeywords)].join(', ');

const jsonLd =
	jsonLdOverride ??
	(type === 'article'
		? blogPostingJsonLd({
				title,
				description,
				url: canonicalUrl,
				image: ogImage,
				imageWidth: ogImageWidth,
				imageHeight: ogImageHeight,
				publishedTime,
				modifiedTime,
				authors,
				categories,
			})
		: webPageJsonLd({
				name: title,
				description,
				url: canonicalUrl,
			}));

const breadcrumbJsonLd =
	breadcrumbs && breadcrumbs.length > 0 ? breadcrumbListJsonLd(breadcrumbs, canonicalUrl) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{keywordsContent && <meta name="keywords" content={keywordsContent} />}
<meta name="robots" content={robots} />
<meta name="theme-color" content={SITE.themeColor} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={SITE.themeColorDark} media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="application/rss+xml" title={SITE.name} href={getCanonicalUrl('/rss.xml')} />
{
	markdownPath && (
		<>
			<link rel="alternate" type="text/markdown" href={getCanonicalUrl(markdownPath)} />
			<link rel="describedby" href={getCanonicalUrl('/llms.txt')} />
		</>
	)
}
<title>{pageTitle}</title>

<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAltText} />
<meta property="og:image:width" content={ogImageWidth} />
<meta property="og:image:height" content={ogImageHeight} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAltText} />

{
	type === 'article' && publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{
	type === 'article' && (modifiedTime ?? publishedTime) && (
		<meta property="article:modified_time" content={(modifiedTime ?? publishedTime)!.toISOString()} />
	)
}
{
	type === 'article' &&
		authors.map((author) => <meta property="article:author" content={author.url} />)
}
{
	type === 'article' &&
		categories.map((category) => <meta property="article:section" content={category} />)
}
{
	type === 'article' &&
		categories.map((category) => <meta property="article:tag" content={category} />)
}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{
	breadcrumbJsonLd && (
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
	)
}

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<Font cssVariable="--font-bricolage" preload />
<Font cssVariable="--font-share-tech-mono" preload />
