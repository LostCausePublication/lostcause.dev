---
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.png';

interface Props {
	href?: string;
}

const { href = '/' } = Astro.props;
---

<a class="logo" href={href}>
	<Image class="logo__avatar" src={avatar} width={40} height={40} densities={[1, 2]} alt="" loading="eager" />
	<span class="logo__text">
		<span class="logo__primary">LOSTCAUSE.</span><span class="logo__accent">DEV</span>
	</span>
</a>
