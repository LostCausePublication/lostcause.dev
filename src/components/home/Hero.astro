---
import { getCategoryStats } from '../../lib/categories';
import { getLatestPosts, getPublishedPosts } from '../../lib/blog';
import { getGlossaryTerms } from '../../lib/glossary';
import { getAllTools } from '../../lib/tools';

const [posts, latestPosts, tools, categories] = await Promise.all([
	getPublishedPosts(),
	getLatestPosts(3),
	getAllTools(),
	getCategoryStats(),
]);

const glossaryCount = getGlossaryTerms().length;
const termLabel = glossaryCount === 1 ? 'term' : 'terms';

const stats = [
	{ label: 'posts', value: String(posts.length) },
	{ label: 'glossary', value: `${glossaryCount} ${termLabel}` },
	{ label: 'tools', value: String(tools.length) },
	{ label: 'topics', value: String(categories.length) },
];
---

<section class="hero" aria-labelledby="hero-heading">
	<div class="hero__copy">
		<p class="hero__eyebrow">JavaScript / TypeScript / Open-source / CLI</p>
		<h1 id="hero-heading" class="hero__title">
			A <span class="hero__accent">not-so-serious</span> coding publication.
		</h1>
		<p class="hero__lede">
			We talk about the JavaScript/TypeScript ecosystem, <span class="hero__nowrap">open-source</span> projects and CLI tools.
		</p>
	</div>
	<div class="hero__terminal" role="region" aria-label="Site stats">
		<div class="hero__terminal-bar" aria-hidden="true">
			<span>~/LOSTCAUSE</span>
			<span>ssh</span>
		</div>
		<div class="hero__terminal-body">
			<p class="hero__cmd"><span class="hero__prompt" aria-hidden="true">$</span> lostcause --stats</p>
			<dl class="hero__stats">
				{
					stats.map((stat) => (
						<div class="hero__stat">
							<dt>{stat.label}</dt>
							<dd>{stat.value}</dd>
						</div>
					))
				}
			</dl>
			{
				latestPosts.length > 0 && (
					<>
						<p class="hero__cmd">
							<span class="hero__prompt" aria-hidden="true">$</span> lostcause --latest
						</p>
						<ul class="hero__latest">
							{latestPosts.map((post) => (
								<li>
									<span class="hero__prompt" aria-hidden="true">
										&gt;
									</span>
									{post.data.title}
								</li>
							))}
						</ul>
					</>
				)
			}
			<p class="hero__cmd hero__cmd--idle" aria-hidden="true">
				<span class="hero__prompt">$</span>
				<span class="hero__cursor"></span>
			</p>
		</div>
	</div>
</section>
