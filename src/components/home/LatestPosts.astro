---
import PostCard from '../blog/PostCard.astro';
import type { BlogPost } from '../../lib/blog';

interface Props {
	posts: BlogPost[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section aria-labelledby="latest-posts-heading">
			<h2 id="latest-posts-heading" class="section-title">
				Latest posts
			</h2>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<PostCard post={post} headingLevel="h3" />
					</li>
				))}
			</ul>
			<a class="more-link" href="/blog/">
				All posts<span aria-hidden="true"> &rarr;</span>
			</a>
		</section>
	)
}
