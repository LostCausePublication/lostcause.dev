---
import PostMeta from './PostMeta.astro';
import CategoryList from './CategoryList.astro';
import type { BlogPost } from '../../lib/blog';
import { getPostSlug } from '../../lib/blog';

interface Props {
	post: BlogPost;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h2' } = Astro.props;
const slug = getPostSlug(post);
---

<article class="post-card">
	<CategoryList categories={post.data.categories} />
	<Heading class="post-card__title">
		<a href={`/blog/${slug}/`}>{post.data.title}</a>
	</Heading>
	<p class="post-card__description">{post.data.description}</p>
	<PostMeta post={post} />
</article>
