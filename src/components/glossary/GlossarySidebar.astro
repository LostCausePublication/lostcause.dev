---
import {
	GLOSSARY_INDEX_PATH,
	getUsedCategories,
	glossaryCategoryPath,
} from '../../lib/glossary';

interface Props {
	activeCategoryId?: string;
}

const { activeCategoryId } = Astro.props;
const categories = getUsedCategories();
---

<nav class="page-aside__section" aria-labelledby="glossary-categories-heading">
	<h2 id="glossary-categories-heading" class="page-aside__title">Categories</h2>
	<ul class="tools-sidebar__list">
		<li>
			<a
				class:list={[
					'tools-sidebar__link',
					'glossary-sidebar__link',
					!activeCategoryId && 'tools-sidebar__link--active',
				]}
				href={GLOSSARY_INDEX_PATH}
				aria-current={!activeCategoryId ? 'page' : undefined}
			>
				<span>All terms</span>
			</a>
		</li>
		{
			categories.map((category) => (
				<li>
					<a
						class:list={[
							'tools-sidebar__link',
							'glossary-sidebar__link',
							activeCategoryId === category.id && 'tools-sidebar__link--active',
						]}
						href={glossaryCategoryPath(category.id)}
						aria-current={activeCategoryId === category.id ? 'page' : undefined}
					>
						<span>{category.label}</span>
						<span class="glossary-sidebar__count">{category.count}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
